# ─── Base de Datos ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://ti_user:ti_secret@localhost:5432/sistema_ti"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANTE: genera secretos seguros con: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=cambia_este_secreto_jwt_en_produccion
JWT_REFRESH_SECRET=cambia_este_refresh_secret_en_produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Seed (credenciales del admin inicial) ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=Admin1234!
