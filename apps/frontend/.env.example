# ─── Frontend — Variables de entorno ──────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno.
#
# ┌─ DESARROLLO LOCAL ─────────────────────────────────────────────────────────┐
# │  El proxy de Vite (vite.config.ts) reenvía /api/* al backend local.        │
# │  axiosClient usa el fallback '/api/v1' si VITE_API_URL apunta a localhost.  │
# │  VITE_API_URL=http://localhost:3000/api/v1                                  │
# └────────────────────────────────────────────────────────────────────────────┘
#
# ┌─ PRODUCCIÓN (Vercel) ───────────────────────────────────────────────────────┐
# │  Configura esta variable en el panel de Vercel:                              │
# │    Settings → Environment Variables → Add                                   │
# │  VITE_API_URL=https://system-ti-backend.onrender.com/api/v1                 │
# └────────────────────────────────────────────────────────────────────────────┘

VITE_API_URL=https://system-ti-backend.onrender.com/api/v1
