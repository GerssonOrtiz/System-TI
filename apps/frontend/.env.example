# ─── Frontend — Variables de entorno ──────────────────────────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno.

# URL base de la API del backend (solo se usa en PRODUCCIÓN).
# En desarrollo, el proxy de Vite en vite.config.ts se encarga de redirigir
# las peticiones /api/* al backend, evitando problemas de CORS.
VITE_API_URL=http://localhost:3000/api/v1
