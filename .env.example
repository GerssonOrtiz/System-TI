# ─── Base de Datos ────────────────────────────────────────────────────────────
POSTGRES_USER=ti_user
POSTGRES_PASSWORD=ti_secret
POSTGRES_DB=sistema_ti
DB_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# IMPORTANTE: cambia estos valores por secretos fuertes en producción
JWT_SECRET=cambia_este_secreto_jwt_en_produccion
JWT_REFRESH_SECRET=cambia_este_refresh_secret_en_produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# URL del frontend para configurar CORS
FRONTEND_URL=http://localhost:5173

# Credenciales del admin inicial (usadas por prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@empresa.com
SEED_ADMIN_PASSWORD=Admin1234!

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
FRONTEND_PORT=80
